	)
	(text "SW1 position NORMAL : contacts 1-2 et 5-6\n  RESET = RST du programmateur (0 V)\n  -> RSTDISBL non programmé\nSW1 position 12 V : contacts 2-3 et 4-5\n  RESET = 12 V quand RST = 0 V\n  -> RSTDISBL programmé (PB3 en E/S)"
		(exclude_from_sim no)
		(at 190.5 172.72 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "69cd51e2-eed6-53ca-9a63-d2178e93577a")
	)
	(text "Vout = 1,25 V x (1 + R3/R4)\n       = 1,25 x (1 + 86,6k/10k) = 12,08 V\nVFB = 1,17 à 1,33 V selon la puce :\nmesurer TP1, viser 11,7 à 12,4 V"
		(exclude_from_sim no)
		(at 203.2 38.1 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "9a0b1b4c-b1ae-55bf-aca0-68c830d2fb3a")
	)
